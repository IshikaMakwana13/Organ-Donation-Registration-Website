<%@ Page Title="About Us | Ishika Organ Donation" Language="C#" MasterPageFile="MasterPage.master" AutoEventWireup="true" CodeFile="4_ABOUT_US.aspx.cs" Inherits="_Default" %>

<asp:Content ID="Content1" ContentPlaceHolderID="holder1" Runat="Server">
    <div class="about_page_wrapper">
        
        <!-- About Section Hero -->
        <section class="about_hero_section">
            <div class="about_hero_card">
                <span class="about_pill">OUR FOUNDATION</span>
                <h1>About Ishika Organ Donation Organization</h1>
                <p class="about_hero_text">
                    To address the pressing challenge of deceased organ donation in India, The Ishika Organization, an NGO with headquarters in Gujarat, established Ishika Organization India. We work tirelessly to address the critical shortage of organ donors and contribute to the development of a supportive, accessible, and transparent organ donation ecosystem.
                </p>
                <p class="about_hero_subtext">
                    Established with the goal of aiding the underprivileged and raising public awareness across Gujarat and India, we are committed to saving lives regardless of social class, age, religion, or background.
                </p>
            </div>
        </section>

        <!-- Mission & Objectives Section -->
        <section class="about_mission_section">
            <div class="mission_card">
                <div class="mission_header">
                    <span class="mission_pill">OUR MISSION</span>
                    <h2>Every Second Counts &bull; Our Resolve To Save Lives</h2>
                </div>
                
                <p class="mission_story">
                    Our mission was born from real-life experience. The wife of one of our core supporters required an urgent heart transplant. While supportive doctors and resources were available, there was no available heart donor in Gujarat, resulting in a critical wait before relocation to an established network in Chennai. Ishika Organization was founded so that every individual in need of an organ transplant in India can receive timely matching without having to leave their lives and homes behind.
                </p>

                <div class="objectives_grid">
                    <div class="obj_card">
                        <div class="obj_icon">💡</div>
                        <h4>Awareness & Prevention</h4>
                        <p>Provide comprehensive education on prevention of renal and liver disorders and cadaveric donation rules.</p>
                    </div>

                    <div class="obj_card">
                        <div class="obj_icon">🤝</div>
                        <h4>Streamlined Process</h4>
                        <p>Ensure smooth, ethical, and rapid donor-recipient coordination for fresh beginnings.</p>
                    </div>

                    <div class="obj_card">
                        <div class="obj_icon">🌟</div>
                        <h4>Dispelling Myths</h4>
                        <p>Remove fear, clear doubts, and encourage families of brain-dead patients to pledge organs.</p>
                    </div>

                    <div class="obj_card">
                        <div class="obj_icon">🛡️</div>
                        <h4>Family Counseling</h4>
                        <p>Assist grieving families with compassionate psychological support and dignity in donation.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Vision Section -->
        <section class="about_vision_section">
            <div class="vision_card">
                <span class="vision_pill">OUR VISION</span>
                <h2>A Future Where No Patient Dies Waiting for an Organ</h2>
                <p>
                    Knowledge and compassion spark transformative change. Serving humanity unconditionally remains our core priority. By raising awareness and offering empathetic support to families, we empower individuals to freely pledge their organs, creating a lasting legacy of life and hope.
                </p>
            </div>
        </section>


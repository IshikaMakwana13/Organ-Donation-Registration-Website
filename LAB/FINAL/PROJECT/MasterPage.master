<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ishika Organ Donation</title>

    <link href="S_1_HOME_PAGE.css?v=3" rel="stylesheet" />
    <link href="S_2_ABOUT_US.css?v=3" rel="stylesheet" />
    <link href="S_3_ORGAN_DETAILS.css?v=3" rel="stylesheet" />
    <link href="S_9_DONOR_APPLY.css?v=3" rel="stylesheet" />

    <style>
        html, body {
            width: 100% !important;
            max-width: 100% !important;
            overflow-x: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
            box-sizing: border-box !important;
        }
        *, *:before, *:after {
            box-sizing: border-box !important;
        }
        .header_top_container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 35px;
            background: #ffffff;
            width: 100%;
        }
        .header_left_brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .header_right_contacts {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .contact_item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: "Arial Rounded MT", sans-serif;
            color: darkblue;
            font-size: 14px;
        }
        .social_item {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        nav.fill ul {
            display: flex !important;
            justify-content: space-evenly !important;
            align-items: center !important;
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
            list-style: none !important;
        }
        nav.fill ul li {
            flex: 1 !important;
            text-align: center !important;
        }
        nav.fill ul li a {
            display: block !important;
            padding: 14px 8px !important;
            text-decoration: none !important;
            color: #3a6ff8 !important;
            font-weight: 800 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.5px !important;
            font-size: 15px !important;
        }
        nav.fill ul li.signout_item a {
            color: #e60012 !important;
        }

        @media screen and (max-width: 768px) {
            .header_upper_bar {
                justify-content: center !important;
                flex-wrap: wrap !important;
                padding: 6px 10px !important;
                gap: 10px !important;
                font-size: 11px !important;
            }
            .header_top_container {
                flex-direction: column !important;
                text-align: center !important;
                padding: 10px 10px !important;
                justify-content: center !important;
            }
            .header_left_brand {
                flex-direction: column !important;
                gap: 8px !important;
                text-align: center !important;
            }
            .header_left_brand label {
                font-size: 19px !important;
                text-align: center !important;
            }
            nav.fill ul {
                flex-wrap: wrap !important;
                justify-content: center !important;
            }
            nav.fill ul li {
                flex: none !important;
            }
            nav.fill ul li a {
                padding: 8px 10px !important;
                font-size: 12px !important;
            }
            #date_lbl {
                font-size: 16px !important;
                padding: 4px 8px !important;
            }
            .donor_btn {
                width: 100% !important;
                max-width: 100% !important;
                margin: 15px auto !important;
            }
            .container {
                height: auto !important;
                min-height: 280px !important;
                width: 100% !important;
                max-width: 100% !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important;
                align-items: center !important;
                padding: 10px 0 !important;
            }
            #tbl_btn {
                border-spacing: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 auto !important;
                display: block !important;
            }
            #tbl_btn tbody, #tbl_btn tr {
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                gap: 25px !important;
                width: 100% !important;
            }
            #tbl_btn td {
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                width: 100% !important;
                text-align: center !important;
                padding: 5px 0 !important;
            }
            #tbl_btn strong center {
                font-size: 15px !important;
                font-weight: bold !important;
                margin-bottom: 8px !important;
                display: block !important;
                color: #1e293b !important;
                text-align: center !important;
            }
            .button {
                width: 240px !important;
                height: 65px !important;
                margin: 0 auto !important;
                display: flex !important;
                position: relative !important;
                perspective: 600px !important;
            }
            .button__text {
                font-size: 22px !important;
                line-height: 65px !important;
            }
        }
    </style>

    <script src="JavaScript.js"></script>
    <script type="text/javascript">
        function updateLiveClock() {
            var lbl = document.getElementById("date_lbl");
            if (lbl) {
                var now = new Date();
                var days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
                var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                
                var dayName = days[now.getDay()];
                var monthName = months[now.getMonth()];
                var day = now.getDate();
                var year = now.getFullYear();
                
                var hours = now.getHours();
                var minutes = now.getMinutes();
                var seconds = now.getSeconds();
                var ampm = hours >= 12 ? 'PM' : 'AM';
                
                hours = hours % 12;
                hours = hours ? hours : 12;
                var strHours = (hours < 10 ? '0' : '') + hours;
                var strMinutes = (minutes < 10 ? '0' : '') + minutes;
                var strSeconds = (seconds < 10 ? '0' : '') + seconds;
                
                lbl.innerText = dayName + ", " + monthName + " " + (day < 10 ? '0' : '') + day + ", " + year + "  " + strHours + ":" + strMinutes + ":" + strSeconds + " " + ampm;
            }
        }
        setInterval(updateLiveClock, 1000);
        window.addEventListener("DOMContentLoaded", updateLiveClock);
    </script>
</head>

<body>

<%@ Page Title="Privacy Policy | Ishika Organ Donation" Language="C#" MasterPageFile="MasterPage.master" AutoEventWireup="true" CodeFile="PRIVACY_POLICY.aspx.cs" Inherits="Privacy_Policy" %>

<asp:Content ID="Content1" ContentPlaceHolderID="holder1" Runat="Server">
    <div class="organ_details_wrapper">
        <div class="organ_details_header">
            <span class="organ_pill">LEGAL & PRIVACY</span>
            <h1>Ishika Organization Privacy Policy</h1>
            <p>Commitment to data security, voluntary consent, and confidentiality under IT Act 2000</p>
        </div>

        <div class="mission_card" style="margin-bottom: 25px;">
            <p class="mission_story">
                Ishika Organization respects the privacy of individuals and complies strictly with data privacy and information security regulations established by the Information Technology Act, 2000 and the Information Technology (Reasonable Security Practices and Procedures and Sensitive Personal Data or Information) Rules, 2011.
            </p>

            <div class="objectives_grid" style="margin-top: 20px;">
                <div class="obj_card">
                    <h4>1. Information Collection</h4>
                    <p>We only collect personal data (name, age, blood group, address, emergency contact) voluntarily provided during donor or patient pledge registrations.</p>
                </div>

                <div class="obj_card">
                    <h4>2. Purpose of Processing</h4>
                    <p>Data is utilized exclusively for generating donor cards, maintaining recipient waiting queues, and facilitating emergency medical donor matching.</p>
                </div>

                <div class="obj_card">
                    <h4>3. Confidentiality</h4>
                    <p>Personal and biometric information is never sold, traded, or shared with unauthorized commercial third parties.</p>
                </div>

                <div class="obj_card">
                    <h4>4. Consent & Rights</h4>
                    <p>Registrants retain full rights to update, review, or withdraw their donor pledge at any time by contacting our coordination team.</p>
                </div>
            </div>
        </div>
    </div>
</asp:Content>
